<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado presionado (dropdown abierto) -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="10dp"/>
                    <solid android:color="@color/borde_gris"/> <!-- Color más oscuro cuando está presionado -->
                    <stroke android:width="2dp" android:color="@color/gris_medio_oscuro"/>
                </shape>
            </item>
            <item android:gravity="end|center_vertical" android:right="8dp">
                <bitmap android:src="@drawable/ic_arrow_drop_down"
                    android:tint="@color/borde_gris"/>
            </item>
        </layer-list>
    </item>

    <!-- Estado normal -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="10dp"/>
                    <solid android:color="@color/gris_claro3"/>
                    <stroke android:width="2dp" android:color="@color/borde_gris"/>
                </shape>
            </item>
            <item android:gravity="end|center_vertical" android:right="8dp">
                <bitmap android:src="@drawable/ic_arrow_drop_down"
                    android:tint="@color/borde_gris"/>
            </item>
        </layer-list>
    </item>
</selector>