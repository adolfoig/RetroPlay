<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gris_medio_oscuro"
    android:layout_marginTop="?attr/actionBarSize"
    android:orientation="vertical"
    android:gravity="center"
    tools:context=".CerrarSesionFragment">

    <!-- Texto centrado -->
    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@android:color/transparent"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="¿Desea cerrar sesión?"
            android:textColor="@color/azul"
            android:textSize="24sp"
            android:textStyle="bold"
            android:padding="3dp"
            android:background="@drawable/rounded_background"
            android:shadowColor="@color/azul"
            android:shadowDx="0"
            android:shadowDy="40"
            android:shadowRadius="25"/>
    </androidx.cardview.widget.CardView>

    <!-- Contenedor horizontal para los botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="16dp">

        <!-- Botón Sí (alineado a la izquierda) -->
        <Button
            android:id="@+id/btnSi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sí"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/azul"
            android:textColor="@color/white"/>

        <!-- Botón No (alineado a la derecha) -->
        <Button
            android:id="@+id/btnNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/azul"
            android:textColor="@color/white"/>
    </LinearLayout>
</LinearLayout>