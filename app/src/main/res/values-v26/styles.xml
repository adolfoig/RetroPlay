<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CustomSpinner" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <!-- Estilo base -->
        <item name="android:background">@drawable/spinner_background</item>
        <item name="android:textColor">@color/borde_gris</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingVertical">12dp</item>

        <!-- Configuración del dropdown -->
        <item name="android:popupBackground">@drawable/spinner_dropdown_background</item>
        <item name="android:dropDownSelector">@drawable/spinner_dropdown_selector</item>
        <item name="android:dropDownWidth">match_parent</item>
    </style>

</resources>