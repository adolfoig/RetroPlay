<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="?attr/actionBarSize">

<androidx.cardview.widget.CardView
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:layout_gravity="center"
android:background="@color/gris4"
app:cardPreventCornerOverlap="true">

<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gris4">

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomContainer"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@android:color/transparent"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/textNombreJuego"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="prueba"
                android:textColor="@color/verde"
                android:textSize="24sp"
                android:textStyle="bold"
                android:padding="3dp"
                android:background="@drawable/rounded_background"
                android:shadowColor="#F0E200"
                android:shadowDx="0"
                android:shadowDy="20"
                android:shadowRadius="25"/>
        </androidx.cardview.widget.CardView>

        <ImageView
            android:id="@+id/imagenJuego"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/pacman"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/textoDescripcion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F0E200"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="20dp"
            android:text="Descripcion" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/btnJugar"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/imagenEstrella"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:src="@drawable/estrellablanca" />
    </LinearLayout>

    <Button
        android:id="@+id/btnJugar"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"
        android:backgroundTint="@color/verde"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:textColor="@color/white"
        android:text="@string/jugar"
        android:layout_margin="5dp"/>
</RelativeLayout>
</androidx.cardview.widget.CardView>
    </LinearLayout>